# Copie para .env e preencha. O .env NÃO é versionado.

# Provedor de LLM: gemini | groq | anthropic | none. Se omitido, usa o primeiro com chave nesta ordem
# (gemini, groq, anthropic); sem nenhuma chave roda em MODO DETERMINÍSTICO (sem agentes de linguagem).
# Com mais de uma chave preenchida, dá para trocar de provedor na interface (seletor "IA" na barra superior).
OBRANEXO_LLM_PROVIDER=gemini

# Google Gemini (nível gratuito da API Gemini Developer — https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Groq (https://console.groq.com/keys) — nível gratuito com limite baixo de tokens por minuto;
# o ObraNexo usa lotes menores de extração com ele. Se a API devolver 403 "Access denied. Please check
# your network settings", o bloqueio é de rede/região do Groq (não da chave): teste de outra rede.
GROQ_API_KEY=

# Anthropic (alternativa)
ANTHROPIC_API_KEY=

# Modelos por provedor (padrões em config.py):
#   gemini:    gemini-3.8-flash / gemini-3.5-flash-lite (reserva gemini-3.5-flash-lite)
#   groq:      openai/gpt-oss-120b / openai/gpt-oss-20b (reserva llama-3.3-70b-versatile)
#   anthropic: claude-sonnet-5-5 / claude-haiku-5-5
# Troque por provedor com OBRANEXO_<PROVEDOR>_MODEL_AGENTE / _MODEL_EXTRACAO / _MODELOS_RESERVA, ex.:
# OBRANEXO_GROQ_MODEL_AGENTE=openai/gpt-oss-120b
# OBRANEXO_GROQ_MODEL_EXTRACAO=openai/gpt-oss-20b
# OBRANEXO_GROQ_MODELOS_RESERVA=llama-3.3-70b-versatile,llama-3.1-8b-instant
# (OBRANEXO_MODEL_AGENTE / OBRANEXO_MODEL_EXTRACAO / OBRANEXO_MODELOS_RESERVA valem para o provedor inicial)

# Limites por análise
OBRANEXO_MAX_PASSOS_INVESTIGADOR=12
OBRANEXO_ORCAMENTO_TOKENS=120000
# Pausa (s) antes de cada chamada — útil no nível gratuito com limite de requisições por minuto
OBRANEXO_LLM_PAUSA_S=0
# Tempo máximo (s) de espera por resposta do modelo antes de usar o reserva
OBRANEXO_LLM_TIMEOUT_S=45
# Extrações de itens simultâneas (reduza para 1-2 se o nível gratuito devolver 429)
OBRANEXO_LLM_PARALELO=4

# Modo offline força o uso dos pacotes congelados em data/casos (nunca chama o PNCP)
OBRANEXO_OFFLINE=0

# Cache de respostas do LLM em disco (reprodutibilidade e economia)
OBRANEXO_LLM_CACHE=1
